# ==================================================
# HƯỚNG DẪN CẤU HÌNH MÔI TRƯỜNG
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên Git
# ==================================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=social_network
DB_PORT=5432

# --- JWT (BẮT BUỘC, tối thiểu 32 ký tự ngẫu nhiên) ---
# Tạo bằng lệnh: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# --- Cloudinary (Upload ảnh/video) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- CORS (Danh sách origin cho phép, phân cách bằng dấu phẩy) ---
# Ví dụ: http://localhost:5173,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# --- App ---
PORT=8080
GIN_MODE=debug
